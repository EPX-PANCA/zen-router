# ============================================================
# ZEN ROUTER — Environment Configuration Template
# Salin file ini menjadi .env dan sesuaikan nilainya.
# cp .env.example .env
# ============================================================

# Environment mode: production | development
APP_ENV=production

# Public Base URL (untuk Cloudflare Tunnel, domain publik, atau reverse proxy)
# Contoh: https://ai.example.com atau http://localhost:20128
PUBLIC_BASE_URL=https://ai.yourdomain.com

# Server port (default: 20128, kompatibel dengan 9router)
PORT=20128

# ─── Google Antigravity OAuth ───────────────────────────────
# Google Antigravity / Code Assist OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google Cloud Project ID
PROJECT_ID=sample-project-p91ab

# OAuth redirect URI (Gunakan localhost untuk kepatuhan Google client)
REDIRECT_URI=http://localhost:20128/api/oauth/callback

# ─── Database ───────────────────────────────────────────────
# Lokasi database SQLite (dalam container Docker)
DATABASE_URL=sqlite:/app/data/zen-router.db

# ─── Security ───────────────────────────────────────────────
# Secret acak minimal 32 karakter untuk sesi enkripsi
SESSION_SECRET=8f4b29c1d3e5a7b0c2d4e6f8a0b1c3d5e7f9a1b3c5d7e9f1a3b5c7d9e1f3a5b7

# ─── Upstream API ───────────────────────────────────────────
# Endpoint resmi Google Antigravity
UPSTREAM_BASE_URL=https://daily-cloudcode-pa.googleapis.com

# Region upstream (Google Anycast edge routing)
UPSTREAM_LOCATION=auto

# ─── Tracing & Logging ──────────────────────────────────────
RUST_LOG=zen_router=info,tower_http=info
